# Ya no es un proyecto de Supabase Cloud. VITE_SUPABASE_URL apunta al backend
# Express (mismo valor que VITE_BACKEND_URL) — sirve /auth/v1/* como proxy
# hacia GoTrue self-hosted.
VITE_SUPABASE_URL=http://localhost:3001
# Placeholder sin función de seguridad real: GoTrue self-hosted (sin Kong) no
# valida el header apikey. No pegar aquí ninguna clave real.
VITE_SUPABASE_ANON_KEY=self-hosted-anon-key-placeholder
VITE_BACKEND_URL=http://localhost:3001
